{
  "name": "pervyy-kurs-handbook",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный электронный справочник для первокурсника",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.student.handbook",
    "productName": "Электронный справочник Первокурсника",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "data.js",
      "app.js",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
